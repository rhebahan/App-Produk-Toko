<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DaftarProdukController"
            stylesheets="@styles/app.css">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label text="Daftar Produk Toko" styleClass="title"/>
            <FlowPane hgap="10" vgap="8">
                <TextField fx:id="cariField" promptText="Cari nama produk" prefWidth="260"
                           onAction="#cari"/>
                <Button text="Cari" onAction="#cari"/>
                <Button text="Reset" onAction="#reset"/>
                <Button text="Tambah Produk" onAction="#tambah" styleClass="button-primary"/>
                <Button text="Lihat Detail" onAction="#detail"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <VBox styleClass="page">
            <TableView fx:id="tabel" VBox.vgrow="ALWAYS" minHeight="200">
                <columns>
                    <TableColumn fx:id="kodeCol" text="Kode" prefWidth="100"/>
                    <TableColumn fx:id="namaCol" text="Nama Produk" prefWidth="320"/>
                    <TableColumn fx:id="kategoriCol" text="Kategori" prefWidth="150"/>
                    <TableColumn fx:id="hargaCol" text="Harga" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" wrapText="true" styleClass="pesan"/>
    </bottom>
</BorderPane>
